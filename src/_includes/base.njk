<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.siteUrl }}{{ canonicalPath }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.siteUrl }}{{ canonicalPath }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ site.siteUrl }}/assets/images/hero-banner.webp">
  <meta property="og:image:width" content="1920">
  <meta property="og:image:height" content="640">
  <meta property="og:image:alt" content="Starfield, network, and studio — Mariano Capezzani">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.siteUrl }}/assets/images/hero-banner.webp">
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="any">
  <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">
  {% if pageId != "home" %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,300;0,6..12,400;0,6..12,700;1,6..12,300&family=Raleway:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
  {% endif %}
  <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
  {% if pageId == "home" %}
  <link rel="stylesheet" href="{{ '/css/home.css' | url }}">
  {% endif %}
</head>
<body class="page-{{ pageId }}">
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="logo" href="{{ '/' | url }}">Mariano Capezzani</a>
      <nav class="nav" id="site-nav" aria-label="Primary">
        {% for item in site.nav %}
        <a href="{{ item.href | url }}" {% if item.id == pageId %}aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>
      <div class="header-social">
        {% for item in site.social %}
        <a href="{{ item.url }}" aria-label="{{ item.name }}" target="_blank" rel="noopener noreferrer">
          <img src="{{ ('/assets/images/' + item.icon) | url }}" alt="" width="23" height="23">
        </a>
        {% endfor %}
      </div>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>
  <main id="content">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="footer-social">
      {% for item in site.social %}
      <a href="{{ item.url }}" aria-label="{{ item.name }}" target="_blank" rel="noopener noreferrer">
        <img src="{{ ('/assets/images/' + item.icon) | url }}" alt="" width="27" height="27">
      </a>
      {% endfor %}
    </div>
    {% if pageId == "home" %}
    <p>© 2026 Mariano Capezzani</p>
    {% else %}
    <p>©2023 MARIANO CAPEZZANI</p>
    {% endif %}
  </footer>
  <script src="{{ '/js/main.js' | url }}"></script>
</body>
</html>
